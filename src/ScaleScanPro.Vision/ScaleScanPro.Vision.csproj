<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScaleScanPro.Core\ScaleScanPro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Model nhận diện mã: được copy ra thư mục chạy của mọi project tham chiếu -->
    <Content Include="Models\best.onnx">
      <Link>Models\best.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Đồng thời nhúng model vào DLL: ClickOnce không đưa file Content của project phụ vào gói,
         bản nhúng giúp app vẫn chạy (xem ModelLocator). -->
    <EmbeddedResource Include="Models\best.onnx" LogicalName="best.onnx" />
  </ItemGroup>

</Project>
