<Window x:Class="ScaleScanPro.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt" Width="640" Height="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBase}" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource TxtSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16">

                <!-- Cơ sở dữ liệu -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cơ sở dữ liệu SQL Server" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Máy chủ"/>
                            <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding Server}"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="CSDL tra PO"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding PoDatabase}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Tài khoản (tra PO)"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding PoUser}"
                                     ToolTip="Để trống để dùng đăng nhập Windows"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Mật khẩu (tra PO)"/>
                            <PasswordBox x:Name="PoPassword" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                                         ToolTip="Để trống nếu không muốn đổi mật khẩu đã lưu"/>
                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="CSDL lịch sử"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding HistoryDatabase}"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Tài khoản (lịch sử)"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Text="{Binding HistoryUser}"/>
                            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Mật khẩu (lịch sử)"/>
                            <PasswordBox x:Name="HistoryPassword" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                                         ToolTip="Để trống nếu không muốn đổi mật khẩu đã lưu"/>
                            <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="Timeout (giây)"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding TimeoutSeconds}"/>
                        </Grid>
                        <TextBlock Text="Mật khẩu được mã hóa bằng Windows DPAPI, không lưu dạng chữ thường."
                                   FontSize="11" Foreground="{StaticResource TxtMuted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   TextTrimming="None"/>
                    </StackPanel>
                </Border>

                <!-- Cân -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cân điện tử (cổng COM)" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cổng COM"/>
                            <ComboBox x:Name="PortCombo" Grid.Column="1" Margin="0,0,0,8" IsEditable="True"
                                      Text="{Binding PortName, UpdateSourceTrigger=LostFocus}" Width="160" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Baud rate"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding BaudRate}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Lệnh yêu cầu số cân"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding RequestCommand}"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Chu kỳ hỏi cân (ms)"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding PollIntervalMs}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Camera -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Camera" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Chỉ số camera"/>
                            <TextBox Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding CameraIndex}"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Độ rộng x cao"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Width="80" Text="{Binding CameraWidth}"/>
                                <TextBlock Text="  ×  " VerticalAlignment="Center"/>
                                <TextBox Width="80" Text="{Binding CameraHeight}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="FPS"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding CameraFps}"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Ngưỡng tin cậy YOLO"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding ConfidenceThreshold}"
                                     ToolTip="Mặc định 0.15. Chỉ đổi sau khi đã kiểm thử độ chính xác quét mã."/>
                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="File video giả lập"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding VideoFilePath}"
                                     ToolTip="Tùy chọn: dùng file video thay camera để kiểm thử"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quy tắc cân -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Quy tắc cân và kiểm tra" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Dung sai (kg)"/>
                            <TextBox Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding ToleranceKg}"
                                     ToolTip="Sai lệch tuyệt đối cho phép. Hệ thống dùng giá trị lớn hơn giữa dung sai kg và dung sai %."/>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Dung sai (%)"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding TolerancePercent}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Số lần đọc ổn định"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding StableCount}"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Độ lệch ổn định (kg)"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding StableSpreadKg}"/>
                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Khối lượng tối thiểu (kg)"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding MinWeightKg}"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Thời gian chờ cân (giây)"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Width="100" HorizontalAlignment="Left" Text="{Binding WaitTimeoutSeconds}"/>
                            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Độ dài tối thiểu mã PO"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding MinPlainCodeLength}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Khác -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Khác" Style="{StaticResource Section}"/>
                        <CheckBox Content="Tìm lịch sử theo chuỗi chứa (chậm hơn tìm theo đầu mã)" IsChecked="{Binding SearchContains}" Margin="0,0,0,8"/>
                        <CheckBox Content="Chế độ chạy thử (giả lập camera, cân và SQL)" IsChecked="{Binding DemoMode}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Thư mục log lệch cân (JSON)" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ErrorLogFolder}" ToolTip="Để trống để dùng thư mục mặc định"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource BtnOutline}" Content="Chọn..." Click="BrowseFolder_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource BgWhite}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
                <Button Style="{StaticResource BtnOutline}" Content="Hủy" Width="90" Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource BtnPrimary}" Content="Lưu" Width="110" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
