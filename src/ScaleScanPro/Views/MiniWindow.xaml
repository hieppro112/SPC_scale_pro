<Window x:Class="ScaleScanPro.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scale Scan Pro - thu nhỏ"
        Width="284" Height="196"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border CornerRadius="12" Background="{StaticResource CameraBg}" BorderBrush="#3A3F55" BorderThickness="1.5"
            ClipToBounds="True" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thanh trên -->
            <Grid Background="#33FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsScaleConnected, Converter={StaticResource StatusBrush}}"/>
                    <TextBlock Text="Scale Scan Pro" Foreground="White" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Content="⤢" Width="28" Height="26" Background="Transparent" BorderThickness="0"
                        Foreground="White" FontSize="13" Cursor="Hand" ToolTip="Phóng to lại" Click="Restore_Click"/>
            </Grid>

            <!-- Hình camera -->
            <Grid Grid.Row="1">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>

                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" CornerRadius="6"
                        Background="#99000000" Padding="8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding WeightText}" Foreground="White" FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text=" g" Foreground="#C7D0FC" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </StackPanel>
                </Border>

                <!-- Thông báo nổi -->
                <Border VerticalAlignment="Bottom" Padding="10,8"
                        Background="{Binding ToastLevel, Converter={StaticResource NoticeBrush}}"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                               TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
